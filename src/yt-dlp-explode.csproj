<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <AssemblyName>yt-dlp-explode</AssemblyName>
    <RootNamespace>YtDlpExplode</RootNamespace>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <IsPackable>false</IsPackable>
    <Version>0.1.1</Version>
    <Authors>meoyawn</Authors>
    <Description>Native AOT CLI targeting yt-dlp compatibility, starting with closed captions.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../external/YoutubeExplode/YoutubeExplode/YoutubeExplode.csproj" />
  </ItemGroup>
</Project>
